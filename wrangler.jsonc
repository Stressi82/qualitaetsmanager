{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qualitaetsmanager",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/.netlify/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qualitaetsmanager",
      "database_id": "0eaf326f-67e2-4b25-9eea-aa9589eb91a2"
    }
  ]
}
